# Porta del servizio locale
PORT=8097
TAVOLAMICA_BIND_ADDRESS=127.0.0.1
# Porta host Docker di esempio, separata dalla porta Node locale.
TAVOLAMICA_BIND_PORT=8107

# Obbligatorio. Ricavarlo dalla propria copia dell'app ufficiale.
# Non pubblicare questo valore e non inserirlo in Git.
TAVOLAMICA_CHECKSUM_SEED=
TAVOLAMICA_APP_TOKEN=

# Opzionali: modalità servizio per bot e automazioni.
# Se omessi, resta disponibile il login interattivo dalla pagina web.
TAVOLAMICA_EMAIL=
TAVOLAMICA_PASSWORD=

# Obbligatorio per /api/v1/* in modalità bot. Generare una stringa casuale.
TAVOLAMICA_API_KEY=

# Cache menu/PDF. Nel container il percorso e impostato a /app/data/cache.
TAVOLAMICA_CACHE_DIR=.cache/tavolamica
TAVOLAMICA_CACHE_TTL_SECONDS=900

# Endpoint ufficiali osservati nell'app 1.9.5.
TAVOLAMICA_USERS_BASE_URL=https://users.tavolamica.it/
TAVOLAMICA_MENU_BASE_URL=https://mmta.tavolamica.it/
